{
  "name": "alexa-mcp-oauth",
  "version": "0.1.0",
  "description": "Drop-in OAuth 2.1 for self-hosted MCP servers that link to Alexa+: PKCE S256, refresh and client-credentials grants, RFC 9728 and RFC 8414 metadata, bearer middleware. Stateless, no database.",
  "type": "module",
  "license": "MIT",
  "author": "hammy229",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hammy229/alexa-mcp-oauth.git"
  },
  "keywords": [
    "alexa",
    "alexa-plus",
    "mcp",
    "model-context-protocol",
    "oauth",
    "pkce",
    "express",
    "account-linking"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "example": "tsx examples/server.ts",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "express": "^4.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.25.0"
  }
}
